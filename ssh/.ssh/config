# SSH client config (stow package "ssh" -> ~/.ssh/config).
# No secrets here: private keys stay in ~/.ssh and are never committed.

# GitHub over port 443 instead of 22. Some networks (eduroam at the
# university) block port 22; ssh.github.com:443 works everywhere HTTPS does.
# Same host key as github.com (Ed25519 SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU).
Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
