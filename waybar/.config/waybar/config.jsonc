// Waybar: top bar. Style "A, solid strip" (piece 5 of notes/loq-visual.md).
// Colours live in style.css; icons are coloured here with Pango <span>.
// Reload after editing: pkill waybar; setsid -f waybar
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "idle_inhibitor",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    // Music from any player (Chrome, Spotify...); hidden when nothing plays.
    "mpris": {
        "format": " {title} — {artist}",
        "format-paused": " {title} — {artist}",
        "max-length": 45,
        "tooltip-format": "{player}: {title} — {artist}"
    },

    "clock": {
        "format": "{:%H:%M  %d/%m}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "<span color='#58a6ff'></span> {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "<span color='#58a6ff'></span> {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    // CPU package sensor (coretemp). The default thermal zone is an ACPI
    // board sensor (acpitz) that showed ~28 °C. hwmonN numbers can change
    // between boots, so select the device by name.
    "temperature": {
        "hwmon-name": "coretemp",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "<span color='#58a6ff'></span> {temperatureC}°",
        "interval": 5
    },

    "network": {
        "format-wifi": "<span color='#58a6ff'></span> {essid}",
        "format-ethernet": "<span color='#58a6ff'></span> wired",
        "format-linked": "<span color='#58a6ff'></span> no IP",
        "format-disconnected": "<span color='#58a6ff'></span> offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}  ({signalStrength}%)",
        "on-click": "kitty --class floating-tui -e nmtui"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": " {device_alias}",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "kitty --class floating-tui -e bluetui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span color='#58a6ff'></span> muted",
        "format-icons": {
            "headphone": "<span color='#58a6ff'></span>",
            "default": ["<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>"]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "bat": "BAT1",
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "<span color='#58a6ff'></span> {capacity}%",
        "format-plugged": "<span color='#58a6ff'></span> {capacity}%",
        "format-icons": ["<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>", "<span color='#58a6ff'></span>"],
        "tooltip-format": "{timeTo}"
    },

    // "Coffee": while active the screen does not lock/turn off (hypridle).
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Auto-lock off",
        "tooltip-format-deactivated": "Auto-lock on"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "reboot": "systemctl reboot",
            "poweroff": "systemctl poweroff"
        }
    }
}
